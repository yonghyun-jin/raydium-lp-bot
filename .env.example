# LP Bot v0 Configuration
# Copy this file to .env and fill in your values

# ===========================================
# NETWORK CONFIGURATION
# ===========================================

# Solana RPC URL
# Free options:
#   - Devnet: https://api.devnet.solana.com
#   - Mainnet (public, slow): https://api.mainnet-beta.solana.com
#   - Mainnet (Helius, recommended): https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Get free Helius key at: https://helius.dev (10k req/day free)
SOLANA_RPC_URL=https://api.devnet.solana.com

# WebSocket URL -- LEAVE UNSET unless you have a reason.
# Unset, it is derived from SOLANA_RPC_URL, which is what you want. Setting it
# independently is how a mainnet RPC ends up with a devnet websocket, and then
# every subscription-based confirmation waits 60s for a notification that can
# never arrive -- a transaction that landed looks like a failure.
# SOLANA_WS_URL=

# ===========================================
# WALLET CONFIGURATION (choose ONE method)
# ===========================================

# Method 1: Private key directly (recommended)
# Export from Phantom: Settings → Security → Export Private Key
# Paste the base58 string here
WALLET_PRIVATE_KEY=

# Method 2: Path to keypair JSON file
# Generate with: solana-keygen new -o ./wallet.json
# WALLET_PATH=~/.config/solana/id.json

# ===========================================
# POOL CONFIGURATION
# ===========================================

# Raydium CLMM Pool ID for SOL-USDC
# IMPORTANT: Must be a CLMM pool (program: CAMMCzo5YL8w4VFF8KVHrK22GGUsp5VTaW7grrKgrWqK)
# NOT an AMM V4 pool (program: 675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8)
# Find pools at: https://raydium.io/clmm/pools/
#
# Recommended SOL-USDC CLMM pools:
#   3ucNos4NbumPLZNWztqGHNFFgkHeRMBQAVemeeomsUxv (0.04% fee, $7M TVL, tickSpacing=1)
#   8sLbNZoA1cfnvMJLPfp98ZLAnFSYCFApfJKMbiXNLwxj (0.01% fee, $478K TVL, tickSpacing=1)
#   2QdhepnKRTLjjSqPL1PtKNwqrUkoLee5Gqs8bvZhRdMv (0.05% fee, $416K TVL, tickSpacing=10)
POOL_ID=

# ===========================================
# SAFETY (read this before anything else)
# ===========================================

# The bot sends NOTHING unless ALLOW_REAL_MONEY=true. Leave it unset (or false)
# until a DRY_RUN rehearsal has passed: npm run rehearse:open -- 10
ALLOW_REAL_MONEY=false

# DRY_RUN=true builds and simulates every transaction but never sends one.
DRY_RUN=true

# Hard ceiling, in USD, for any single position or swap. Default 25.
# Raise it only after you have watched the bot run small.
MAX_POSITION_USD=25

# ===========================================
# STRATEGY SETTINGS
# ===========================================
# v0 always opens on a FIXED range: live price -4% .. +4%.
# It is set in src/orchestrator/prediction.ts (V0_HALF_WIDTH_PCT).

# Tick array search range: how many tick arrays to check on each side
# For tickSpacing=4 (SOL-USDC): 20 arrays ≈ -38% to +62% price range
# Increase if pool has sparse liquidity far from current price
TICK_ARRAY_SEARCH_RANGE=20

# ===========================================
# MEV PROTECTION (Mainnet only)
# ===========================================

# Use Jito for MEV protection
# true = private transactions via Jito bundles
# false = regular RPC (exposed to MEV bots)
USE_JITO=true

# Jito tip amount in SOL (only if USE_JITO=true)
# Bundle tip BOUNDS in SOL -- not the tip itself.
#
# The tip is sized off Jito's live tip_floor (95th percentile of landed tips)
# and clamped between these. JITO_TIP_SOL is the floor and the fallback when
# that endpoint is unreachable; JITO_TIP_SOL_MAX stops a congestion spike from
# bidding the wallet away (the 99th percentile runs ~0.0056 SOL).
#
# This value was documented and set here for months with NO CODE READING IT,
# while the real tip was a hardcoded 0.00001 SOL -- the median of landed tips.
# It cost a rebalance its reopen on 2026-09-25. It is live now.
JITO_TIP_SOL=0.0001
JITO_TIP_SOL_MAX=0.002

# ===========================================
# DATABASE (Railway auto-injects this)
# ===========================================

# PostgreSQL connection string
# Local: postgresql://user:password@localhost:5432/lp_strategy
# Railway: auto-injected when you add PostgreSQL service
DATABASE_URL=

# ===========================================
# TELEGRAM BOT
# ===========================================

# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ===========================================
# OPTIONAL: EXTERNAL SERVICES
# ===========================================

# CoinGecko API (optional, for price feed backup)
# Free tier: no key needed, but rate limited (30 req/min)
# Pro: https://www.coingecko.com/api/pricing
# COINGECKO_API_KEY=

# Telegram authorization (REQUIRED -- the bot fails closed without it).
# Comma-separated Telegram user ids allowed to drive the bot. An unset or empty
# value refuses every update; the refusal message reports the caller's own id so
# you can fill this in. On an ARMED bot (ALLOW_REAL_MONEY=true) an unauthorized
# user can spend, not just read, which is why this refuses rather than admits.
TELEGRAM_ALLOWED_USER_IDS=
