{
  "name": "lp-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only P&L dashboard for the LP bot. Its own package so express never enters the bot dependency tree.",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "dev:server": "ts-node server/index.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "ts-node server/index.ts",
    "db:generate": "mkdir -p prisma && cp ../prisma/schema.prisma prisma/schema.prisma && prisma generate --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tabler/icons-react": "^3.49.0",
    "@web3icons/react": "^4.1.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "radix-ui": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^3.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}
