# Environment variables (contains API keys, wallet private keys)
.env
.env.local
.env.*.local

# Wallet files (NEVER commit these)
wallet.json
*.keypair.json
keypair.json
id.json

# State files (contain position data, NFT mints)
.bot-position.json
.orchestrator-state/

# Removed in B1 -- session state lives in Postgres now. Ignored so a stale
# directory from an older checkout can never be committed again: the tracked
# copy carried a real Telegram user and chat id.
.telegram-state/

# Dependencies
node_modules/

# Build outputs
dist/
build/
*.tsbuildinfo

# Logs
*.log
logs/

# Database files
*.db
*.db-wal
*.db-shm
data/ledger.db*

# Test coverage
coverage/
.nyc_output/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Python
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
venv/
.venv/


# Temporary files
*.tmp
*.temp
.cache/

# Dashboard build artefacts.
#
# dashboard/prisma/ is a COPY of prisma/schema.prisma, regenerated by
# `npm run db:generate`. It exists only because `prisma generate` resolves the
# client relative to the schema's directory, and committing it would create the
# second source of truth for the schema that the whole layout avoids.
dashboard/node_modules/
dashboard/web/dist/
dashboard/prisma/

# Parallel checkouts. `git worktree add .worktrees/<name>` puts a second full
# checkout inside this one; without this line every file in it shows up as
# untracked in `git status` here. Also excluded from the Docker context --
# see the matching entry in .dockerignore.
.worktrees/

# Playwright visual-regression run output (baselines ARE committed)
dashboard/test-results/
dashboard/playwright-report/
